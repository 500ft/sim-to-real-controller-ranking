{
  "schema_version": "1.0",
  "project": "Autonomous Racing Systems",
  "prerequisites": {
    "install": "python -m pip install -e . --no-deps && python -m pip install -r requirements-report.txt",
    "env": {
      "PYTHONPATH": "gym",
      "MPLBACKEND": "Agg"
    },
    "note": "Every command below assumes these. PYTHONPATH=gym is required because this repository's own gym/ directory must shadow the third-party gym package for the vendored f110_gym imports to resolve; without it the generators fail at import. MPLBACKEND=Agg is required for headless runs.",
    "numeric_gate": "reports/figures/dynamic_replay_*.png are NOT byte-comparable: the renderer moves glyphs and layout between font builds. Compare runs/dynamic_model_replay/metrics.csv instead, via experiments/test_replay_metrics.py (tolerance 1e-9 relative; observed cross-run spread 1e-15).",
    "figure_rules": "experiments/figure_style.py sets Computer Modern type, black-ink marker and line conventions and 600 dpi output for every generator, and refuses to save a figure whose printed items touch. Each rebuilt figure's words live in <stem>.caption.md beside the image. redraw_command entries rebuild PNGs and captions from committed run files without a simulation, fit or bag; python -m unittest discover -s experiments -p 'test_figure_*.py' checks plotted values, canvas text, the overlap audit and captions."
  },
  "figures": [
